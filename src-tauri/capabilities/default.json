{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal do Eskuta. Restritivo por padrão — só libera o que o app precisa pra funcionar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/eskuta-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}

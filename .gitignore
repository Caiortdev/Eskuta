# ============================================================
# Eskuta — .gitignore
# ============================================================

# --- Node / Vite / Frontend ---
node_modules/
dist/
dist-ssr/
*.local
.vite/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Rust / Tauri ---
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/WixTools/
# Cargo.lock fica comitado (app desktop precisa de build reprodutível)

# Sidecar binaries gerados pelo PyInstaller (são build artifacts, não fonte)
src-tauri/binaries/

# --- Python / Sidecar ---
src-python/venv/
src-python/.venv/
src-python/__pycache__/
src-python/**/__pycache__/
src-python/*.egg-info/
src-python/.pytest_cache/
src-python/.mypy_cache/
src-python/.ruff_cache/
src-python/dist/
src-python/build/
src-python/*.spec
**/*.pyc
**/*.pyo

# --- Secrets / Config sensível ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# --- Dados do usuário em dev (paths em ~/.eskuta) ---
# (ficam no home, não no repo — mas se alguém criar local pra teste)
.eskuta/
.atena/

# --- Coverage / Testes ---
coverage/
.coverage
htmlcov/
.nyc_output/
*.cover
.tox/

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db
